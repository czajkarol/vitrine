# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Art Institute of Chicago -------------------------------------------------
# No API key exists. AIC asks that you identify your app and give a contact address.
AIC_USER_AGENT="vitrine (your.email@example.com)"
AIC_BASE_URL=https://api.artic.edu/api/v1
AIC_TIMEOUT_SECONDS=10
AIC_MAX_REQUESTS_PER_MINUTE=55   # AIC allows 60; leave headroom

# --- Application --------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=data/vitrine.db
DEFAULT_LANGUAGE=en
DEFAULT_INTERVAL_MINUTES=5

# --- AI (entirely optional; the app works fully without any of this) -----------
AI_ENABLED=false
AI_PROVIDER=                     # openai | anthropic | gemini | mock
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=600
AI_DAILY_REQUEST_LIMIT=200       # hard stop; guards against a runaway rotation
AI_CIRCUIT_BREAKER_THRESHOLD=5   # consecutive failures before opening
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Shared cache -------------------------------------------------------------
# Interface only. See docs/adr/0004-defer-shared-cache.md. Leave disabled.
SHARED_CACHE_ENABLED=false
SHARED_CACHE_URL=
