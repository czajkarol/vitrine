# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Art Institute of Chicago -------------------------------------------------
# No API key exists. AIC asks that you identify your app and give a contact address.
AIC_USER_AGENT="vitrine (karolkczaj@gmail.com)"
AIC_BASE_URL=https://api.artic.edu/api/v1
AIC_TIMEOUT_SECONDS=10
AIC_MAX_REQUESTS_PER_MINUTE=55   # AIC allows 60; leave headroom

# --- Application --------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text                 # text for a terminal, json for shipping logs somewhere
DATABASE_PATH=data/vitrine.db
DEFAULT_LANGUAGE=en
DEFAULT_INTERVAL_SECONDS=300   # 30 | 60 | 300 | 900 | 1800

# --- Rate limiting ------------------------------------------------------------
# Applied to /api/artwork/random and /api/image/{image_id}, the two routes whose
# cost leaves the machine. Not about AIC's 60/min — the local index keeps us far
# under that — but about a stuck tab running all night. BURST=0 disables it.
RATE_LIMIT_BURST=10
RATE_LIMIT_REFILL_SECONDS=3      # one token per N seconds; 3 is 20/min sustained
RATE_LIMIT_HOURLY=400            # rolling ceiling; 0 leaves only the bucket

# --- AI (entirely optional; the app works fully without any of this) -----------
AI_ENABLED=false
# mock | anthropic | openai — only a name the code implements is accepted, so a typo
# fails at startup. The comment is on its own line, and has to be: python-dotenv strips
# a trailing comment only when a value comes before it, so `KEY=  # note` on an empty
# key reads the note itself as the value. Found by copying this file on a clean
# checkout, where it made the app refuse to start.
AI_PROVIDER=
# Blank means the provider's own default. Same rule as above — a comment here would
# become the model id, and that one fails at the provider rather than at startup.
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=600
AI_DAILY_REQUEST_LIMIT=200       # hard stop; guards against a runaway rotation
AI_CIRCUIT_BREAKER_THRESHOLD=5   # consecutive failures before opening
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# One per implemented provider. GEMINI_API_KEY and the SHARED_CACHE_* pair used to be
# here and were removed: nothing read them. `Settings` ignores unknown keys, so a line
# with no field behind it is silently inert rather than an error — which is precisely why
# it must not sit in the example file looking like a setting.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
